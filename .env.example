# Base URL for the membrs API. Empty means the app reads the bundled fixtures
# in src/fixtures, which is how the lite rollout ships until the backend exists.
VITE_API_BASE=

# PostHog project key (starts with phc_). It is a public, write-only key and
# is safe in the bundle. Empty turns analytics off.
VITE_POSTHOG_KEY=

# The PostHog cloud region the project lives in: us or eu. The dev server
# forwards /ingest there; vercel.json does the same in production, so keep
# its rewrites on the same region.
VITE_POSTHOG_REGION=us
