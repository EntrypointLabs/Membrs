# Base URL for the membrs API, e.g. http://localhost:24081/api locally. In
# production it is /api, because the backend serves the site on the same
# origin. Every listing, place and promo comes from it; left empty, the app
# shows no listings rather than sample data.
VITE_API_BASE=

# PostHog project key (starts with phc_). It is a public, write-only key and
# is safe in the bundle. Empty turns analytics off.
VITE_POSTHOG_KEY=

# The PostHog cloud region the project lives in: us or eu. The dev server
# forwards /ingest there; the backend does the same in production, so keep
# its proxy on the same region.
VITE_POSTHOG_REGION=us
